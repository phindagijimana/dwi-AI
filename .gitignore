__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
*.so

# Site-specific / local notes — do not commit
nodestrength.local.md
*.local.md

# Generated Word doc — regenerate locally from nodestrength.md
nodestrength.docx


# Large research PDF stays on disk but not in version control.
*.pdf

# Editor noise
.vscode/
.idea/
vendor/
.idea/
*.swp
.DS_Store

# Container build artifacts
*.sif
containers/*.sif
containers/.build-tmp/
containers/.test-out/
containers/.test-out-strength-only/

# Local / PHI — never commit real cohort outputs, subject IDs, or site paths
sample_report*/
sample_report_*/
node_strength_results/
scripts/outputs/
participants.tsv
**/participants.tsv
!tests/**/participants.tsv

# IDE / agent local settings (may contain machine-specific paths)
.claude/
