Bootstrap: docker
From: python:3.11-slim-bookworm

%labels
    Author nodestrength
    Version 0.1.0
    org.opencontainers.image.title nodestrength
    Description Standalone DK node strength + strength AI + volume AI

%environment
    export PYTHONUNBUFFERED=1
    export PYTHONDONTWRITEBYTECODE=1

%files
    pyproject.toml /app/pyproject.toml
    node.md /app/node.md
    README.md /app/README.md
    nodestrength /app/nodestrength
    scripts /app/scripts
    containers/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
    BCT.md /app/BCT.md
    paper.md /app/paper.md
    nodestrength.md /app/nodestrength.md
    other_analysis.md /app/other_analysis.md

%post
    cd /app
    apt-get update && apt-get install -y --no-install-recommends git \
        libx11-6 libxext6 libxrender1 libsm6 libgl1 libglib2.0-0 \
        && rm -rf /var/lib/apt/lists/*
    pip install --upgrade pip
    pip install -e ".[bct,viz]"
    chmod +x /usr/local/bin/docker-entrypoint.sh

%runscript
    exec /usr/local/bin/docker-entrypoint.sh "$@"
